{
  "name": "sap-bin-web",
  "private": true,
  "description": "Builds the page's stylesheet with Tailwind CSS. Only the compiled app.css ships; the page loads nothing but its own files.",
  "scripts": {
    "build:css": "tailwindcss -i styles/app.css -o app.css --minify",
    "watch:css": "tailwindcss -i styles/app.css -o app.css --watch",
    "fonts": "node styles/copy-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
